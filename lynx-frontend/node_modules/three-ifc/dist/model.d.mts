import './graphics/geometry.mjs';
import * as THREE from 'three';
import { EntityInstance } from './entityInstance.mjs';
import { EntityType } from './entityType.mjs';
import { ModelId, ExpressId, InstancedMeshId } from './types.mjs';
import { Metadata } from './metadata.mjs';
import { InstancedMesh } from './graphics/instancedMesh.mjs';
import './graphics/material.mjs';
import './graphics/meshInstance.mjs';
import 'web-ifc';

declare class Model {
    id: ModelId;
    group: Group;
    rootExpressId: ExpressId;
    entityInstances: Map<ExpressId, EntityInstance>;
    metadata: Metadata;
    constructor(id: ModelId, group: Group, rootExpressId: ExpressId, entityInstances: Map<ExpressId, EntityInstance>, metadata: Metadata);
    setVisibleInstances(visibleExpressIds: Set<ExpressId>): void;
    getEntityTypes(): EntityType[];
}

/**
 * Group represents a collection of InstancedMeshes.
 */
declare class Group {
    instancedMeshes: Map<InstancedMeshId, InstancedMesh>;
    threeJsInstance: THREE.Group;
    constructor(modelId: ModelId, instancedMeshes: Map<InstancedMeshId, InstancedMesh>);
    /**
     * Sets visibility of mesh instances based on Express IDs
     */
    setVisibleInstances(visibleExpressIds: Set<ExpressId>, model: Model): void;
}

export { Group as G, Model };
