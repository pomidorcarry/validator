import * as THREE from 'three';
import { InstancedMeshId, MeshInstanceId } from '../types.mjs';
import { Geometry } from './geometry.mjs';
import { Material } from './material.mjs';
import { MeshInstance } from './meshInstance.mjs';

/**
 * InstancedMesh represents a single Three.js InstancedMesh with tracking of visible/invisible instances.
 */
declare class InstancedMesh {
    id: InstancedMeshId;
    geometry: Geometry;
    material: Material;
    instancesOrder: MeshInstanceId[];
    instances: Map<MeshInstanceId, MeshInstance>;
    threeJsInstance: THREE.InstancedMesh;
    instanceUpdateBlocked: boolean;
    constructor(id: InstancedMeshId, geometry: Geometry, material: Material);
    addInstances(newInstances: Set<MeshInstance>): void;
    /**
     * Sets visible instances and rebuilds the buffer to match
     */
    setVisibleInstances(visibleInstanceIds: Set<MeshInstanceId>): void;
    updateInstanceSelectState(meshInstanceId: MeshInstanceId, selected: boolean, color: THREE.Color, triggerThreeJsInstanceUpdate?: boolean): void;
    updateInstanceHighlightState(meshInstanceId: MeshInstanceId, highlighted: boolean, color: THREE.Color, triggerThreeJsInstanceUpdate?: boolean): void;
    checkIfCompletelyInvisible(): boolean;
}

export { InstancedMesh };
